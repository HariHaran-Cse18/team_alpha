# MEDORA AI - Environment Configuration Example

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database (Default uses local SQLite; uncomment for PostgreSQL)
DATABASE_URL=sqlite:///./medora.db
# DATABASE_URL=postgresql://user:password@localhost:5432/medora_db

# Security & JWT
SECRET_KEY=medora-hackathon-secure-jwt-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Decision-Support Engine Defaults
DEFAULT_LEAD_TIME_BUFFER=1.2
EMERGENCY_RESERVE_SAFETY_FACTOR=1.0
AUTO_REVIEW_CYCLE_DAYS=7
